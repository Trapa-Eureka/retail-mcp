# DESIGN.md §8 + TASKS.md T0 반영사항. 실제 값은 .env에만 작성하고 커밋하지 않는다.

# --- 웨어하우스 ---
# 설정하면 Neon/Supabase 등 네트워크 Postgres를 쓴다. 비워두면 로컬 임베디드 PGlite로
# 자동 대체된다(SPEC.md §12, TASKS T14) — 계정 가입·연결 문자열 설정 없이 npm install만으로
# 쓸 수 있게 하기 위함이다. 다지점을 한 DB로 모으고 싶으면 DATABASE_URL을 설정한다.
DATABASE_URL=
# DATABASE_URL이 없을 때 임베디드 PGlite 데이터를 저장할 경로. 기본값은 .retail-mcp/data.
RETAIL_MCP_DATA_DIR=

# --- Loyverse POS ---
LOYVERSE_API_TOKEN=
# 외부 요청 타임아웃(ms)과 재시도 상한 — 무한 재시도 금지 (SPEC §10)
LOYVERSE_REQUEST_TIMEOUT_MS=10000
LOYVERSE_MAX_RETRIES=5
# 클라이언트 쪽 속도 제한(슬라이딩 윈도우) — Loyverse 공식 문서(developer.loyverse.com/docs
# "API rate limits", 2026-09-03 확인)의 계정당 한도는 "300 requests per 300 sec"다. 같은
# 계정을 다른 곳(Postman 등)에서도 쓸 여지를 감안해 기본값은 그보다 낮게 잡는다 — 무료 플랜
# 여부와 무관하게 계정 단위 한도이므로 이 값을 초과 조정하지 않는 게 안전하다.
LOYVERSE_RATE_LIMIT_MAX_REQUESTS=250
LOYVERSE_RATE_LIMIT_WINDOW_MS=300000

# --- 발송 이중 게이트 (가드레일 1) ---
# dry_run | live — live 전환은 사람만. 실발송은 SEND_MODE=live AND agent 실행 인자 --confirm 둘 다 필요.
SEND_MODE=dry_run
RESEND_API_KEY=
MAIL_FROM=
REPORT_RECIPIENT=

# --- LLM (요약 전용, 수치 생성 금지) ---
ANTHROPIC_API_KEY=

# --- 운영 설정 ---
# "최근 N일" 등 기간 경계 계산에 사용하는 사업장 타임존. DB 저장은 항상 UTC.
BUSINESS_TIMEZONE=Asia/Manila
# sync_now MCP 도구 등록 여부. 운영 기본값은 비활성(false) — DESIGN §11.4.
SYNC_TOOL_ENABLED=false
# 조회 도구·리포트에 stale 경고를 붙이는 기준(시간). 기본 24 — SPEC §9, core/freshness.ts.
STALE_THRESHOLD_HOURS=24
