# Reflects DESIGN.md §8 + TASKS.md T0. Write real values only in .env and never commit them.

# --- Warehouse ---
# When set, a network Postgres such as Neon/Supabase is used. When left empty, it automatically
# falls back to local embedded PGlite (SPEC.md §12, TASKS T14) — so that it works with just
# npm install, without signing up for an account or configuring a connection string. Set DATABASE_URL if you want to consolidate multiple branches into one DB.
DATABASE_URL=
# Path where embedded PGlite data is stored when DATABASE_URL is absent. Default is .retail-mcp/data.
RETAIL_MCP_DATA_DIR=

# --- CSV/Excel folder scan (agent:folder-scan, TASKS T18·T20) ---
# branch (branch, default) | consolidated (HQ consolidation) — the variables below differ by mode.
CSV_MODE=branch
# [branch] Folder to watch for the inventory file (SPEC §12 fixed template, .csv/.xlsx). If there are
# several, only the most recently modified file is used.
CSV_WATCH_DIR=
# [branch] Folder where snapshot CSVs (TASKS T19) are written — must differ from CSV_WATCH_DIR (if they
# are the same, the next scan misreads the snapshot as a new source file).
CSV_SNAPSHOT_DIR=
# [branch] Default low-stock threshold for items with no sales history (per-item override is the CSV's low_stock_threshold column).
CSV_DEFAULT_LOW_STOCK_THRESHOLD=5
# [consolidated] Collection folder where branch snapshot files gather — every file in the folder is processed per branch.
CSV_COLLECT_DIR=

# --- SCM inbound receipts (optional, branch mode only, TASKS T26, SPEC §16) ---
# Real Google Sheets API integration was not adopted — service account setup is a high entry
# barrier for non-developer users, and the public-link approach exposes sensitive information
# such as purchase unit cost. Instead, export the Google Sheet via "File > Download > CSV" and
# place it in this folder; the next scan reads it as is (the same pattern as the "ERP exports to
# CSV → folder channel" precedent in SPEC §12). When left empty, SCM receipt loading and inventory
# consistency verification are skipped (exactly identical to the existing behavior).
SCM_RECEIPTS_DIR=
# Can be omitted if the inventory file in CSV_WATCH_DIR has exactly one store (auto-inferred). Required with multiple stores.
SCM_RECEIPTS_STORE_ID=

# --- Loyverse POS ---
LOYVERSE_API_TOKEN=
# External request timeout (ms) and retry cap — no infinite retries (SPEC §10)
LOYVERSE_REQUEST_TIMEOUT_MS=10000
LOYVERSE_MAX_RETRIES=5
# Client-side rate limit (sliding window) — per the official Loyverse docs (developer.loyverse.com/docs
# "API rate limits", checked 2026-09-03), the per-account limit is "300 requests per 300 sec". To
# leave room for using the same account elsewhere (Postman etc.), the default is set lower than that —
# the limit is per account regardless of free-plan status, so it is safest not to raise this value above it.
LOYVERSE_RATE_LIMIT_MAX_REQUESTS=250
LOYVERSE_RATE_LIMIT_WINDOW_MS=300000

# --- Send double gate (guardrail 1) ---
# dry_run | live — switching to live is human-only. A live send requires both SEND_MODE=live AND the agent run argument --confirm.
SEND_MODE=dry_run
RESEND_API_KEY=
MAIL_FROM=
REPORT_RECIPIENT=

# --- LLM (summaries only, generating numbers is forbidden) ---
ANTHROPIC_API_KEY=

# --- Operational settings ---
# Business timezone used for period-boundary calculations such as "last N days". DB storage is always UTC.
BUSINESS_TIMEZONE=Asia/Manila
# Whether to register the sync_now MCP tool. Production default is disabled (false) — DESIGN §11.4.
SYNC_TOOL_ENABLED=false
# Threshold (hours) for attaching a stale warning to query tools and reports. Default 24 — SPEC §9, core/freshness.ts.
STALE_THRESHOLD_HOURS=24
# Whether to register the explore_sql MCP tool (arbitrary SELECT queries, TASKS T27). Production default is disabled (false) —
# a BEGIN READ ONLY transaction blocks writes (guardrail 4), but it stays off by default anyway. Check the
# README "Permission separation" checklist before enabling it.
EXPLORE_SQL_ENABLED=false
# To enable explore_sql without DATABASE_URL (embedded PGlite), this must also be true (TASKS T30,
# SEC-001/002) — PGlite does not support role-based permission separation or statement_timeout
# enforcement, so both of explore_sql's safety mechanisms are missing. Connecting to a real Postgres
# such as Neon/Supabase with a dedicated role that has no execute permission on dangerous functions is strongly recommended.
EXPLORE_SQL_ALLOW_PGLITE=false
# npm run cleanup (007 OPS-005, TASKS T34) deletes rows older than this many days from
# agent_send_log/inventory_snapshots. Run by a human, dry-run by default (--confirm required, same
# pattern as guardrail 1) — this project does not create an automatic run schedule on your behalf (see README "Retention policy").
CLEANUP_RETENTION_DAYS=90
