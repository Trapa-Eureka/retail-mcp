{
  "name": "@trapa-eureka/retail-mcp",
  "version": "0.1.0",
  "description": "리테일 다지점 셀스루·재고 BI MCP 서버 + 재주문 제안 에이전트",
  "license": "MIT",
  "author": "Trapa Eureka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trapa-Eureka/retail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Trapa-Eureka/retail-mcp/issues"
  },
  "homepage": "https://github.com/Trapa-Eureka/retail-mcp#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "bin": {
    "retail-mcp": "dist/server.js",
    "retail-mcp-onboard": "dist/cli/onboard.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx src/server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "agent:reorder": "tsx src/agent/reorder.ts",
    "agent:folder-scan": "tsx src/agent/folderScan.ts",
    "onboard": "tsx src/cli/onboard.ts",
    "smoke": "tsx scripts/smoke.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && chmod +x dist/server.js dist/cli/onboard.js",
    "prepack": "npm run build",
    "verify:pack": "tsx scripts/verifyPack.ts",
    "test:pg-component": "vitest run --config vitest.component.config.ts",
    "audit:lockfile": "tsx scripts/auditLockfile.ts",
    "secret-scan": "tsx scripts/secretScan.ts",
    "sbom": "npm sbom --omit=dev --sbom-format cyclonedx"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.8.3",
    "exceljs": "^4.4.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  }
}
